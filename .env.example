# Creative OS — copy to .env.local and fill in values you use.

# Gemini (captions, Imagen stills, optional Veo) — server-side in vite define
GEMINI_API_KEY=

# Google OAuth (YouTube Shorts publish) — also paste in app Links
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Hugging Face — prefer in-app Links (localStorage); optional here for dev
# VITE_HF_TOKEN=

# Stripe billing (payment API)
# Client (safe in browser):
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
VITE_STRIPE_PRICE_PRO=price_...
VITE_STRIPE_PRICE_CREDITS_10=price_...
VITE_STRIPE_PRICE_CREDITS_50=price_...

# Server only — for `npm run payment-api` (NEVER prefix with VITE_)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PORT=4242
APP_ORIGIN=http://localhost:5173

# MuAPI (optional paid video) — prefer in-app Links
# MUAPI_KEY=

# YouTube Automation Agent — github.com/darkzOGx/youtube-automation-agent
VITE_YOUTUBE_AGENT_URL=http://127.0.0.1:3456
VITE_YOUTUBE_AGENT_API_KEY=

# Wan2GP local GPU video — github.com/deepbeepmeep/Wan2GP
# Clone Wan2GP, then: export WAN2GP_ROOT=/path/to/Wan2GP && npm run wangp-bridge
WAN2GP_ROOT=
WANGP_BRIDGE_PORT=7867
WANGP_MODEL_TYPE=wan2.2_t2v_14B
VITE_WANGP_MODEL_TYPE=wan2.2_t2v_14B

# SOLDIOM Content Factory — deterministic content studio
SCF_DEPLOY_MODE=local
SCF_API_PORT=7870
SCF_PROJECTS_ROOT=./projects
VITE_SCF_DEPLOY_MODE=local
# RunPod GPU render (optional)
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# GCP Cloud Run + storage (optional)
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GCP_CLOUD_RUN_URL=
GCP_STORAGE_BUCKET=
# ElevenLabs voice (optional)
ELEVENLABS_API_KEY=
