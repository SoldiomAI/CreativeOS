{
  "name": "performance-creative-os",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --host 0.0.0.0",
    "dev:all": "node server/payment-api.mjs & vite --port 5173 --host 0.0.0.0",
    "payment-api": "node server/payment-api.mjs",
    "wangp-bridge": "python3 server/wangp-bridge.py",
    "content-factory": "cd soldiom-content-factory && python3 -m uvicorn api.main:app --host 0.0.0.0 --port 7870",
    "content-factory:cli": "python3 soldiom-content-factory/cli.py",
    "build": "vite build",
    "preview": "vite preview --port 4173 --host 0.0.0.0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.29.1",
    "@gradio/client": "^2.4.0",
    "@huggingface/inference": "^4.13.24",
    "express": "^4.21.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
