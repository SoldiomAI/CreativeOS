# Creative OS — copy to .env.local and fill in values you use.

# Gemini (captions, Imagen stills, optional Veo) — server-side in vite define
GEMINI_API_KEY=

# Google OAuth (YouTube Shorts publish) — also paste in app Links
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Hugging Face — prefer in-app Links (localStorage); optional here for dev
# VITE_HF_TOKEN=

# Stripe billing (payment API)
# Client (safe in browser):
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
VITE_STRIPE_PRICE_PRO=price_...
VITE_STRIPE_PRICE_CREDITS_10=price_...
VITE_STRIPE_PRICE_CREDITS_50=price_...

# Server only — for `npm run payment-api` (NEVER prefix with VITE_)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PORT=4242
APP_ORIGIN=http://localhost:5173

# MuAPI (optional paid video) — prefer in-app Links
# MUAPI_KEY=

# YouTube Automation Agent — github.com/darkzOGx/youtube-automation-agent
VITE_YOUTUBE_AGENT_URL=http://127.0.0.1:3456
VITE_YOUTUBE_AGENT_API_KEY=
